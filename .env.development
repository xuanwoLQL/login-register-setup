# .env.development，开发模式下被加载

# 接口前缀（注意有前导斜杠）：
# axios baseURL 用它，发出的请求形如 http://localhost:8002/api/login，
# MSW 的 http.post('/api/login', ...) 才能正确匹配
VITE_APP_BASE_API='/api'

# 开发环境启用 MSW（网络层 mock）
VITE_APP_USE_MOCK='true'

# localStorage / sessionStorage 里 token 的键名
VITE_APP_TOKEN_KEY='lrs_token'
